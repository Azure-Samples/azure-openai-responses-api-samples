# .env

# Configuration for AzureOpenAI
AZURE_OPENAI_API_KEY=<YOUR AZURE OPENAI KEY>
AZURE_OPENAI_API_ENDPOINT=https://<YOUR ENDPOINT>.openai.azure.com/
AZURE_OPENAI_V1_API_ENDPOINT=https://<YOUR ENDPOINT>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Additional variables for gpt-image-1, if different from above
AZURE_OPENAI_API_IMAGE_KEY=<YOUR GPT-IMAGE-1 AZURE OPENAI KEY>
AZURE_OPENAI_V1_API_IMAGE_ENDPOINT=https://<YOUR GPT-IMAGE-1 ENDPOINT>.openai.azure.com/openai/v1/

# Additional variables for Microsoft Web IQ Entra ID client credentials
# Bind this application (client) ID to your Web IQ profile before running the sample.
WEBIQ_TENANT_ID=<YOUR ENTRA DIRECTORY (TENANT) ID>
WEBIQ_CLIENT_ID=<YOUR ENTRA APPLICATION (CLIENT) ID>
WEBIQ_CLIENT_SECRET=<YOUR ENTRA CLIENT SECRET>
KEY_VAULT_URL=https://<YOUR KEY VAULT NAME>.vault.azure.net/
WEBIQ_CLIENT_SECRET_NAME=webiq-client-secret
